    "Axes": {
      "name": "Axes",
      "url": "https://geogebra.github.io/docs/manual/en/commands/Axes/",
      "overloads": [
        {
          "syntax": "Axes(<Conic>)",
          "params": [
            {
              "name": "conic",
              "role": "target_conic",
              "type": "Conic",
              "optional": false
            }
          ],
          "description": "返回给定二次曲线（圆锥曲线）的长轴和短轴两条轴线的方程。"
        },
        {
          "syntax": "Axes(<Quadric>)",
          "params": [
            {
              "name": "quadric",
              "role": "target_quadric",
              "type": "Quadric",
              "optional": false
            }
          ],
          "description": "为给定二次曲面创建 3 条轴线。若是圆柱，则返回底面圆的两条轴和旋转轴；若是球，则返回与坐标轴平行的三条轴。"
        }
      ]
    },
