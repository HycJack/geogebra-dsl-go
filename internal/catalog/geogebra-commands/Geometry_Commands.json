{
    "category": "Geometry Commands",
    "count": 64,
    "commands": {
        "AngleBisector": {
  "name": "AngleBisector",
  "url": "https://geogebra.github.io/docs/manual/en/commands/AngleBisector/",
  "overloads": [
    {
      "syntax": "AngleBisector(<Line>, <Line>)",
      "params": [
        {
          "name": "<Line>",
          "role": "line1",
          "type": "Line",
          "optional": false
        },
        {
          "name": "<Line>",
          "role": "line2",
          "type": "Line",
          "optional": false
        }
      ],
      "description": "Returns both angle bisectors of the two given lines（返回两条直线的两条角平分线）"
    },
    {
      "syntax": "AngleBisector(<Point>, <Point>, <Point>)",
      "params": [
        {
          "name": "<Point>",
          "role": "point1",
          "type": "Point",
          "optional": false
        },
        {
          "name": "<Point>",
          "role": "apex",
          "type": "Point",
          "optional": false
        },
        {
          "name": "<Point>",
          "role": "point3",
          "type": "Point",
          "optional": false
        }
      ],
      "description": "Returns the angle bisector of the angle defined by three points, where the second point is the vertex（返回由三个点定义的角的角平分线，第二个点为角顶点）"
    }
  ]
},

"Arc": {
  "name": "Arc",
  "url": "https://geogebra.github.io/docs/manual/en/commands/Arc/",
  "overloads": [
    {
      "syntax": "Arc(<Circle>, <Point M>, <Point N>)",
      "params": [
        {
          "name": "<Circle>",
          "role": "circle",
          "type": "Circle",
          "optional": false
        },
        {
          "name": "<Point M>",
          "role": "start_point",
          "type": "Point",
          "optional": false
        },
        {
          "name": "<Point N>",
          "role": "end_point",
          "type": "Point",
          "optional": false
        }
      ],
      "description": "Returns the directed (counterclockwise) arc of the given circle with endpoints M and N（返回给定圆上以 M 为起点、N 为终点的逆时针有向圆弧）"
    },
    {
      "syntax": "Arc(<Ellipse>, <Point M>, <Point N>)",
      "params": [
        {
          "name": "<Ellipse>",
          "role": "ellipse",
          "type": "Ellipse",
          "optional": false
        },
        {
          "name": "<Point M>",
          "role": "start_point",
          "type": "Point",
          "optional": false
        },
        {
          "name": "<Point N>",
          "role": "end_point",
          "type": "Point",
          "optional": false
        }
      ],
      "description": "Returns the directed (counterclockwise) arc of the given ellipse with endpoints M and N（返回给定椭圆上以 M 为起点、N 为终点的逆时针有向椭圆弧）"
    },
    {
      "syntax": "Arc(<Circle>, <Parameter Value>, <Parameter Value>)",
      "params": [
        {
          "name": "<Circle>",
          "role": "circle",
          "type": "Circle",
          "optional": false
        },
        {
          "name": "<Parameter Value>",
          "role": "param1",
          "type": "Number",
          "optional": false
        },
        {
          "name": "<Parameter Value>",
          "role": "param2",
          "type": "Number",
          "optional": false
        }
      ],
      "description": "Returns the circular arc of the given circle whose endpoints are identified by the given parameter values（通过参数值确定端点的圆弧，圆可参数化为 (r cos(t), r sin(t))）"
    },
    {
      "syntax": "Arc(<Ellipse>, <Parameter Value>, <Parameter Value>)",
      "params": [
        {
          "name": "<Ellipse>",
          "role": "ellipse",
          "type": "Ellipse",
          "optional": false
        },
        {
          "name": "<Parameter Value>",
          "role": "param1",
          "type": "Number",
          "optional": false
        },
        {
          "name": "<Parameter Value>",
          "role": "param2",
          "type": "Number",
          "optional": false
        }
      ],
      "description": "Returns the elliptic arc of the given ellipse whose endpoints are identified by the given parameter values（通过参数值确定端点的椭圆弧，椭圆可参数化为 (a cos(t), b sin(t))）"
    }
  ]
},

"Area": {
  "name": "Area",
  "url": "https://geogebra.github.io/docs/manual/en/commands/Area/",
  "overloads": [
    {
      "syntax": "Area(<Point>, …, <Point>)",
      "params": [
        {
          "name": "<Point>",
          "role": "vertex",
          "type": "Point",
          "optional": false
        }
      ],
      "description": "Returns the area of the polygon defined by the given vertices（由一串点定义的多边形面积）"
    },
    {
      "syntax": "Area(<Conic>)",
      "params": [
        {
          "name": "<Conic>",
          "role": "conic",
          "type": "Conic",
          "optional": false
        }
      ],
      "description": "Returns the area of a circle or ellipse（圆或椭圆的面积）"
    },
    {
      "syntax": "Area(<Polygon>)",
      "params": [
        {
          "name": "<Polygon>",
          "role": "polygon",
          "type": "Polygon",
          "optional": false
        }
      ],
      "description": "Returns the area of a polygon as the absolute value of its algebraic area（多边形的面积，取代数面积的绝对值；自相交多边形可能给出意外结果）"
    }
  ]
},
