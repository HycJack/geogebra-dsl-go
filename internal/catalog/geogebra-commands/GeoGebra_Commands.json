              "name": "icon_number",
              "role": "icon_number",
              "type": "Number",
              "optional": false
            },
            {
              "name": "first_vertex",
              "role": "first_vertex",
              "type": "Point",
              "optional": false
            },
            {
              "name": "second_vertex",
              "role": "second_vertex",
              "type": "Point",
              "optional": false
