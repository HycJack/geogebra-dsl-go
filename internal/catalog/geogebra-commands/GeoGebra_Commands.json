        {
          "syntax": "SetConstructionStep( <Number> )",
          "params": [
            {
              "name": "step",
              "role": "step_number",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "Changes the construction step to the given value."
        }
      ]
    },
    {
      "name": "SlowPlot",
      "url": "https://geogebra.github.io/docs/manual/en/commands/SlowPlot/",
      "overloads": [
        {
          "syntax": "SlowPlot( <Function> )",
          "params": [
            {
              "name": "function",
              "role": "function_to_plot",
              "type": "Function",
              "optional": false
            }
          ],
          "description": "Creates an animated graph of the given function, plotted from left to right."
        },
        {
          "syntax": "SlowPlot( <Function>, <Boolean Repeat> )",
          "params": [
            {
              "name": "function",
              "role": "function_to_plot",
              "type": "Function",
              "optional": false
            },
            {
              "name": "repeat",
              "role": "repeat_animation",
              "type": "Boolean",
              "optional": false
            }
          ],
          "description": "Creates an animated graph plotted from left to right. If Repeat is false, the graph is plotted only once; if Repeat is true or omitted, the graph is plotted continuously."
        }
      ]
    },
    {
      "name": "ToolImage",
      "url": "https://geogebra.github.io/docs/manual/en/commands/ToolImage/",
      "overloads": [
