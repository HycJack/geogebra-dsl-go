              "type": "Number",
              "optional": false
            },
            {
              "name": "anchor_point",
              "role": "anchor_point",
              "type": "Point",
              "optional": false
            }
          ],
          "description": "Creates in the Graphics View a 32x32 pixel image of the tool icon, anchored to the given point."
