        }
      ]
    },
    {
      "name": "CASLoaded",
      "url": "https://geogebra.github.io/docs/manual/en/commands/CASLoaded/",
      "overloads": [
        {
          "syntax": "CASLoaded()",
          "params": [],
          "description": "Returns a boolean value: true if CAS commands were already loaded, false otherwise. The value is dynamic (changes to true when CAS commands are loaded)."
        }
      ]
    },
    {
      "name": "ConstructionStep",
      "url": "https://geogebra.github.io/docs/manual/en/commands/ConstructionStep/",
      "overloads": [
        {
          "syntax": "ConstructionStep()",
          "params": [],
          "description": "Returns the current Construction Protocol step as a number."
        },
        {
          "syntax": "ConstructionStep( <Object> )",
          "params": [
            {
              "name": "object",
              "role": "target_object",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Returns the Construction Protocol step for the given object as a number."
        }
      ]
    },
    {
      "name": "Corner",
      "url": "https://geogebra.github.io/docs/manual/en/commands/Corner/",
      "overloads": [
        {
          "syntax": "Corner( <Number of Corner> )",
          "params": [
            {
              "name": "corner_index",
              "role": "corner_number",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "For number n = 1, 2, 3, 4 creates a point at the corner of the Graphics View; for n = 5 returns point (w, h), where w and h are width and height of the Graphics View in pixels."
        },
        {
          "syntax": "Corner( <Graphics View>, <Number of Corner> )",
          "params": [
            {
              "name": "graphics_view",
              "role": "graphics_view_id",
              "type": "GraphicsView",
              "optional": false
            },
            {
              "name": "corner_index",
              "role": "corner_number",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "Creates a point at the corner of the specified Graphics View (Graphics View (1, 2)), which is never visible in that view."
        },
        {
          "syntax": "Corner(-1, <Number>)",
          "params": [
            {
              "name": "view_identifier",
              "role": "view_id",
              "type": "Number",
              "optional": false
            },
            {
              "name": "number",
              "role": "property_id",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "For 3D Graphics View: use -1 as view identifier; numbers 1–8 correspond to corners, 9–13 to additional properties such as view size, view direction and axis scales."
        },
        {
          "syntax": "Corner( <Image>, <Number of Corner> )",
          "params": [
            {
              "name": "image",
              "role": "target_image",
              "type": "Image",
              "optional": false
            },
            {
              "name": "corner_index",
              "role": "corner_number",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "Creates a point at the corner of the image (n = 1, 2, 3, 4)."
        },
        {
          "syntax": "Corner( <Text>, <Number of Corner> )",
          "params": [
            {
              "name": "text",
              "role": "target_text",
              "type": "Text",
              "optional": false
            },
            {
              "name": "corner_index",
              "role": "corner_number",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "Creates a point at the corner of the text (n = 1, 2, 3, 4)."
        }
      ]
    },
    {
      "name": "DynamicCoordinates",
      "url": "https://geogebra.github.io/docs/manual/en/commands/DynamicCoordinates/",
      "overloads": [
        {
          "syntax": "DynamicCoordinates( <Point>, <x-Coordinate>, <y-Coordinate> )",
          "params": [
            {
              "name": "point",
              "role": "base_point",
              "type": "Point",
              "optional": false
            },
            {
              "name": "x_coordinate",
              "role": "x_expr",
              "type": "Expression",
              "optional": false
            },
            {
              "name": "y_coordinate",
              "role": "y_expr",
              "type": "Expression",
              "optional": false
            }
          ],
          "description": "Creates a new dependent point (2D). When you move the new point to coordinates (x, y), the given point is moved there and coordinates for the new point are recalculated."
        },
        {
          "syntax": "DynamicCoordinates( <Point>, <x-Coordinate>, <y-Coordinate>, <z-Coordinate> )",
          "params": [
            {
              "name": "point",
              "role": "base_point",
              "type": "Point",
              "optional": false
            },
            {
              "name": "x_coordinate",
              "role": "x_expr",
              "type": "Expression",
              "optional": false
            },
            {
              "name": "y_coordinate",
              "role": "y_expr",
              "type": "Expression",
              "optional": false
            },
            {
              "name": "z_coordinate",
              "role": "z_expr",
              "type": "Expression",
              "optional": false
            }
          ],
          "description": "Creates a new dependent point (3D). When you move the new point to coordinates (x, y, z), the given point is moved there and coordinates for the new point are recalculated."
        }
      ]
    },
    {
      "name": "Name",
      "url": "https://geogebra.github.io/docs/manual/en/commands/Name/",
      "overloads": [
        {
          "syntax": "Name( <Object> )",
          "params": [
            {
              "name": "object",
              "role": "target_object",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Returns the name of an object as a text in the Graphics View."
        }
      ]
    },
    {
      "name": "Object",
      "url": "https://geogebra.github.io/docs/manual/en/commands/Object/",
