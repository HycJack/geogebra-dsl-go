              "type": "Text",
              "optional": false
            }
          ],
          "description": "Returns the object for a given name. The result is always a dependent object."
        }
      ]
    },
    {
      "name": "SetConstructionStep",
      "url": "https://geogebra.github.io/docs/manual/en/commands/SetConstructionStep/",
