{
  "command_category": "Logic_Commands",
  "total_commands": 11,
  "commands": {
    "CountIf": {
      "name": "CountIf",
      "url": "https://geogebra.github.io/docs/manual/en/commands/CountIf/",
      "overloads": [
        {
          "syntax": "CountIf( <Condition>, <List> )",
          "params": [
            {
              "name": "Condition",
              "role": "logical condition",
              "type": "Boolean expression",
              "optional": false
            },
            {
              "name": "List",
              "role": "list of objects or numbers",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Counts the number of elements in the list satisfying the condition."
        },
        {
          "syntax": "CountIf( <Condition>, <Variable>, <List> )",
          "params": [
            {
              "name": "Condition",
              "role": "logical condition",
              "type": "Boolean expression",
              "optional": false
            },
            {
              "name": "Variable",
              "role": "variable to use in condition",
              "type": "Object/Point",
              "optional": false
            },
            {
              "name": "List",
              "role": "list of objects or points",
              "type": "List",
              "optional": false
            }
          ],
          "description": "As above, using a more flexible syntax with a variable."
        }
      ]
    },
    "If": {
      "name": "If",
      "url": "https://geogebra.github.io/docs/manual/en/commands/If/",
      "overloads": [
        {
          "syntax": "If( <Condition>, <Then> )",
          "params": [
            {
              "name": "Condition",
              "role": "logical condition",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Then",
              "role": "object if condition true",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Yields a copy of the object <Then> if the condition is true, and an undefined object if it is false."
        },
        {
          "syntax": "If( <Condition>, <Then>, <Else> )",
          "params": [
            {
              "name": "Condition",
              "role": "logical condition",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Then",
              "role": "object if condition true",
              "type": "Object",
              "optional": false
            },
            {
              "name": "Else",
              "role": "object if condition false",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Yields a copy of <Then> if the condition is true, or a copy of <Else> if it is false. <Then> and <Else> must be of the same type."
        },
        {
          "syntax": "If( <Condition 1>, <Then 1>, <Condition 2>, <Then 2>, …, <Else> )",
          "params": [
            {
              "name": "Condition 1",
              "role": "first logical condition",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Then 1",
              "role": "object if first condition true",
              "type": "Object",
              "optional": false
            },
            {
              "name": "Condition 2",
              "role": "second logical condition",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Then 2",
              "role": "object if second condition true",
              "type": "Object",
              "optional": false
            },
            {
              "name": "Else",
              "role": "object if none of the conditions are met",
              "type": "Object",
              "optional": true
            }
          ],
          "description": "Multiple conditional branches. Returns the corresponding <Then k> for the first true condition, <Else> if provided and no condition is true, or undefined otherwise."
        }
      ]
    },
    "IsDefined": {
      "name": "IsDefined",
      "url": "https://geogebra.github.io/docs/manual/en/commands/IsDefined/",
      "overloads": [
        {
          "syntax": "IsDefined( <Object> )",
