    "KeepIf": {
      "name": "KeepIf",
      "url": "https://geogebra.github.io/docs/manual/en/commands/KeepIf/",
      "overloads": [
        {
          "syntax": "KeepIf( <Condition>, <List> )",
          "params": [
            {
              "name": "Condition",
              "role": "logical condition",
              "type": "Boolean expression",
              "optional": false
            },
            {
              "name": "List",
              "role": "list to be filtered",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Creates a new list that only contains those elements of the initial list that fulfil the condition."
        },
        {
          "syntax": "KeepIf( <Condition>, <Variable>, <List> )",
          "params": [
            {
              "name": "Condition",
              "role": "logical condition",
              "type": "Boolean expression",
              "optional": false
            },
            {
              "name": "Variable",
              "role": "iteration variable used in condition",
              "type": "Object/Point",
              "optional": false
            },
            {
              "name": "List",
              "role": "list to be filtered",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Same as above, but uses an explicit variable that is substituted by each element of the list when evaluating the condition."
        }
      ]
    },
    "Relation": {
      "name": "Relation",
      "url": "https://geogebra.github.io/docs/manual/en/commands/Relation/",
      "overloads": [
        {
          "syntax": "Relation( <List> )",
          "params": [
            {
              "name": "List",
              "role": "list of objects to analyse",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Shows a message box that gives information about the relation between two or more (up to 4) objects in the list."
        },
        {
          "syntax": "Relation( <Object>, <Object> )",
          "params": [
            {
              "name": "Object 1",
              "role": "first object",
              "type": "Object",
              "optional": false
            },
            {
              "name": "Object 2",
              "role": "second object",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Shows a message box that gives information about the relation between two objects (e.g. parallel, perpendicular, equal, incident, etc.)."
        }
      ]
    }
  }
}