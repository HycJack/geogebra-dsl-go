    {
      "name": "Cross",
      "url": "https://geogebra.github.io/docs/manual/en/commands/Cross/",
      "overloads": [
        {
          "syntax": "Cross( <Vector u>, <Vector v> )",
          "params": [
            {
              "name": "u",
              "role": "first_vector",
              "type": "VectorOrList",
              "optional": false
            },
            {
              "name": "v",
              "role": "second_vector",
              "type": "VectorOrList",
              "optional": false
            }
          ],
          "description": "Calculates the cross product of u and v. u, v can be 3D vectors or lists. For 2D vectors/points, the result is the z-coordinate of the cross product. In CAS, if vectors contain undefined variables, a symbolic cross product formula is returned. The operator u ⊗ v can also be used."
        }
      ]
    },
