    {
      "name": "PerpendicularVector",
      "url": "https://geogebra.github.io/docs/manual/en/commands/PerpendicularVector/",
      "overloads": [
        {
          "syntax": "PerpendicularVector( <Line> )",
          "params": [
            {
              "name": "Line",
              "role": "input_line",
              "type": "Line",
              "optional": false
            }
          ],
          "description": "Returns one of the perpendicular vectors to the line. For a line with equation a x + b y = c, the components of the perpendicular vector are (a, b). If a point is specified in the line definition, the perpendicular vector originates at that point; otherwise the origin is at (0, 0)."
        },
        {
          "syntax": "PerpendicularVector( <Segment> )",
          "params": [
            {
              "name": "Segment",
              "role": "input_segment",
              "type": "Segment",
              "optional": false
            }
          ],
          "description": "Returns one of the perpendicular vectors to the segment, having the same length as the segment. If a point is specified in the definition, the vector originates from that point; otherwise origin is at (0, 0)."
        },
        {
          "syntax": "PerpendicularVector( <Vector> )",
          "params": [
            {
              "name": "Vector",
              "role": "input_vector",
              "type": "Vector",
              "optional": false
            }
          ],
          "description": "Returns one of the perpendicular vectors to the given vector. Example: Let Vector((-12, 8)) be the vector u. PerpendicularVector(u) yields v = (-8, -12). If a point is specified in the definition, the vector originates from that point; otherwise origin is at (0, 0)."
        },
        {
          "syntax": "PerpendicularVector((a, b))",
          "params": [
            {
              "name": "(a, b)",
              "role": "input_point_pair",
              "type": "Point",
              "optional": false
            }
          ],
          "description": "Yields the perpendicular vector (-b, a)."
        },
        {
          "syntax": "PerpendicularVector( <Plane> )",
          "params": [
            {
              "name": "Plane",
              "role": "input_plane",
              "type": "Plane",
              "optional": false
            }
          ],
          "description": "Creates a vector orthogonal to the plane, with starting point at (0, 0, 0)."
        }
      ]
    },
