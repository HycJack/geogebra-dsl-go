  "commands": [
    {
      "name": "ApplyMatrix",
      "url": "https://geogebra.github.io/docs/manual/en/commands/ApplyMatrix/",
      "overloads": [
        {
          "syntax": "ApplyMatrix( <Matrix>, <Object> )",
          "params": [
            {
              "name": "M",
              "role": "transformation_matrix",
              "type": "Matrix",
              "optional": false
            },
            {
              "name": "O",
              "role": "object_to_transform",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Transforms object O so that point P of O is mapped to M*P, when P is a 2D point and M is a 2×2 matrix."
        },
        {
          "syntax": "ApplyMatrix( <Matrix>, <Object> )",
          "params": [
            {
              "name": "M",
              "role": "transformation_matrix",
              "type": "Matrix",
              "optional": false
            },
            {
              "name": "O",
              "role": "object_to_transform",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Transforms object O so that point P of O is mapped to project(M*(x(P), y(P), 1)), when P is a 2D point and M is a 3×3 matrix. project maps (x, y, z) to (x/z, y/z)."
        },
        {
          "syntax": "ApplyMatrix( <Matrix>, <Object> )",
          "params": [
            {
              "name": "M",
              "role": "transformation_matrix",
              "type": "Matrix",
              "optional": false
            },
            {
              "name": "O",
              "role": "object_to_transform",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Transforms object O so that point P of O is mapped to M*P, when P is a 3D point and M is a 3×3 matrix."
        },
        {
          "syntax": "ApplyMatrix( <Matrix>, <Object> )",
          "params": [
            {
              "name": "M",
              "role": "transformation_matrix",
              "type": "Matrix",
              "optional": false
            },
            {
              "name": "O",
              "role": "object_to_transform",
              "type": "Object",
              "optional": false
            }
          ],
          "description": "Transforms object O in 3D when P is a 3D point and M is a 2×2 matrix: the matrix N is the 3×3 completion of M so that P is mapped by N*P."
        }
      ]
    },
