    "ContingencyTable": {
      "name": "ContingencyTable",
      "url": "https://geogebra.github.io/docs/manual/en/commands/ContingencyTable/",
      "overloads": [
        {
          "syntax": "ContingencyTable( <List of Text>, <List of Text> )",
          "params": [
            {
              "name": "rowValues",
              "role": "rowValues",
              "type": "ListOfText",
              "optional": false
            },
            {
              "name": "columnValues",
              "role": "columnValues",
              "type": "ListOfText",
              "optional": false
            }
          ],
          "description": "Draws a contingency table created from two lists of text values; unique values of the first list are row labels, of the second list are column labels。"
        },
        {
          "syntax": "ContingencyTable( <List of Text>, <List of Text>, <Options> )",
          "params": [
            {
              "name": "rowValues",
              "role": "rowValues",
              "type": "ListOfText",
              "optional": false
            },
            {
              "name": "columnValues",
              "role": "columnValues",
              "type": "ListOfText",
              "optional": false
            },
            {
              "name": "options",
              "role": "options",
              "type": "Text",
              "optional": false
            }
          ],
          "description": "在由两列文本创建的列联表中，使用 Options 控制是否显示列百分比、行百分比、总百分比、期望频数、卡方贡献或检验结果（\"|\", \"_\", \"+\", \"e\", \"k\", \"=\"）。"
        },
        {
          "syntax": "ContingencyTable( <List of Row Values>, <List of Column Values>, <Frequency Table> )",
          "params": [
            {
              "name": "rowValues",
              "role": "rowValues",
              "type": "ListOfText",
              "optional": false
            },
            {
              "name": "columnValues",
              "role": "columnValues",
              "type": "ListOfText",
              "optional": false
            },
            {
              "name": "frequencyTable",
              "role": "frequencyTable",
              "type": "ListOfListOfNumber",
              "optional": false
            }
          ],
          "description": "根据给定的行标签列表、列标签列表和二维频数表绘制列联表。"
        },
        {
          "syntax": "ContingencyTable( <List of Row Values>, <List of Column Values><Frequency Table>, <Options> )",
          "params": [
            {
              "name": "rowValues",
              "role": "rowValues",
              "type": "ListOfText",
              "optional": false
            },
            {
              "name": "columnValuesAndFrequencyTable",
              "role": "columnValuesAndFrequencyTable",
              "type": "Composite(ListOfText+FrequencyTable)",
              "optional": false
            },
            {
              "name": "options",
              "role": "options",
              "type": "Text",
              "optional": false
            }
          ],
          "description": "与上一重载类似，但第二个参数组合了列标签和频数表（语法中二者之间无逗号），并通过 Options 控制是否显示额外统计量。"
        }
      ]
    },
    "ContinuedFraction": {
      "name": "ContinuedFraction",
      "url": "https://geogebra.github.io/docs/manual/en/commands/ContinuedFraction/",
      "overloads": [
        {
          "syntax": "ContinuedFraction( <Number> )",
          "params": [
            {
              "name": "<Number>",
              "role": "value",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "用连分数对给定实数进行逼近，返回对应的文本/表达形式。"
        },
        {
          "syntax": "ContinuedFraction( <Number>, <Level> )",
          "params": [
            {
              "name": "<Number>",
              "role": "value",
              "type": "Number",
              "optional": false
            },
            {
              "name": "<Level>",
              "role": "maxQuotients",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "用最多 Level 个部分商的连分数逼近给定实数；实际部分商个数≤Level，且不会超过达到 10^-8 精度所需的个数。"
        },
        {
          "syntax": "ContinuedFraction( <Number>, <Level> (optional), <Boolean Shorthand> )",
          "params": [
            {
              "name": "<Number>",
              "role": "value",
              "type": "Number",
              "optional": false
            },
            {
              "name": "<Level> (optional)",
              "role": "maxQuotients",
              "type": "Number",
              "optional": true
            },
            {
              "name": "<Boolean Shorthand>",
              "role": "shorthand",
              "type": "Boolean",
              "optional": false
            }
          ],
          "description": "与前一重载类似，可选 Level 限制部分商数量；当 Boolean Shorthand 为 true 时，返回更简洁的 LaTeX 文本，仅列出连分数整数部分列表。"
        }
      ]
    },
