    {
      "name": "BoxPlot",
      "url": "https://geogebra.github.io/docs/manual/en/commands/BoxPlot/",
      "overloads": [
        {
          "syntax": "BoxPlot( <yOffset>, <yScale>, <List of Raw Data> )",
          "params": [
            {
              "name": "yOffset",
              "role": "y_offset",
              "type": "Number",
