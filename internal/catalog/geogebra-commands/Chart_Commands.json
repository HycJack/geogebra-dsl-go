            },
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Use Density",
              "role": "use_density",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Density Scale Factor",
              "role": "density_scale_factor",
