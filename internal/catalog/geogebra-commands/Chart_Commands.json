              "role": "cumulative",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
