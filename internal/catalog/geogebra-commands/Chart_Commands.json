    },
    {
      "name": "LineGraph",
      "url": "https://geogebra.github.io/docs/manual/en/commands/LineGraph/",
      "overloads": [
        {
          "syntax": "LineGraph( <List of x-coordinates>, <List of y-coordinates> )",
          "params": [
            {
              "name": "List of x-coordinates",
              "role": "x_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "List of y-coordinates",
              "role": "y_list",
              "type": "List(Number)",
              "optional": false
            }
          ],
          "description": "Creates a chart connecting by line segments the points with coordinates defined in the lists. x-coordinates list is numeric and in increasing order; y-coordinates list provides corresponding y values."
        }
      ]
    },
    {
      "name": "NormalQuantilePlot",
      "url": "https://geogebra.github.io/docs/manual/en/commands/NormalQuantilePlot/",
      "overloads": [
        {
          "syntax": "NormalQuantilePlot( <List of Raw Data> )",
          "params": [
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Creates a normal quantile plot from the given data and draws a reference line showing the ideal plot for exactly normal data. Each data value is plotted on the x-axis against its expected normal score (Z-score) on the y-axis, computed using Filliben's estimate."
        }
      ]
    },
    {
      "name": "PieChart",
      "url": "https://geogebra.github.io/docs/manual/en/commands/PieChart/",
      "overloads": [
        {
          "syntax": "PieChart( <List of Frequencies> )",
          "params": [
            {
              "name": "List of Frequencies",
              "role": "frequency_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Creates a pie chart using a list of frequencies. The full circle represents 100%, and each value forms a proportional slice. Default center is (0,0) and default radius is 3."
        },
        {
          "syntax": "PieChart( <List of Frequencies>, <Center>, <Radius> )",
          "params": [
            {
              "name": "List of Frequencies",
              "role": "frequency_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Center",
              "role": "center_point",
              "type": "Point",
              "optional": false
            },
            {
              "name": "Radius",
              "role": "radius",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "Creates a pie chart with specified center and radius using a list of frequencies. The whole pie is 100%, values form slices proportionally."
        }
      ]
    },
    {
      "name": "ResidualPlot",
      "url": "https://geogebra.github.io/docs/manual/en/commands/ResidualPlot/",
      "overloads": [
        {
          "syntax": "ResidualPlot( <List of Points>, <Function> )",
