            },
            {
              "name": "yScale",
              "role": "y_scale",
              "type": "Number",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List(Number)",
              "optional": false
            }
          ],
          "description": "Creates a box plot using the given raw data and whose vertical position in the coordinate system is controlled by variable yOffset and whose height is influenced by factor yScale."
        },
        {
          "syntax": "BoxPlot( <yOffset>, <yScale>, <Start Value>, <Q1>, <Median>, <Q3>, <End Value> )",
          "params": [
            {
              "name": "yOffset",
              "role": "y_offset",
              "type": "Number",
              "optional": false
            },
            {
              "name": "yScale",
              "role": "y_scale",
              "type": "Number",
              "optional": false
            },
            {
              "name": "Start Value",
              "role": "interval_start",
              "type": "Number",
              "optional": false
            },
            {
              "name": "Q1",
              "role": "quartile_1",
              "type": "Number",
              "optional": false
            },
            {
              "name": "Median",
              "role": "median",
              "type": "Number",
              "optional": false
            },
            {
              "name": "Q3",
              "role": "quartile_3",
              "type": "Number",
              "optional": false
            },
            {
              "name": "End Value",
              "role": "interval_end",
              "type": "Number",
              "optional": false
            }
          ],
          "description": "Creates a box plot for the given statistical data in interval (Start Value, End Value)."
        },
        {
          "syntax": "BoxPlot( <yOffset>, <yScale>, <List of Raw Data>, <Boolean Outliers> )",
          "params": [
            {
              "name": "yOffset",
              "role": "y_offset",
              "type": "Number",
              "optional": false
            },
            {
              "name": "yScale",
              "role": "y_scale",
              "type": "Number",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "Outliers",
              "role": "show_outliers",
              "type": "Boolean",
              "optional": false
            }
          ],
          "description": "This allows outliers to be plotted as \"X\"s rather than included in the boxplot. For this command, outliers are data lying below Q1 - 1.5 * (Q3 - Q1) or above Q3 + 1.5 * (Q3 - Q1)."
        },
        {
          "syntax": "BoxPlot( <yOffset>, <yScale>, <List of Data>, <List of Frequencies>, <Boolean Outliers> )",
          "params": [
            {
              "name": "yOffset",
              "role": "y_offset",
              "type": "Number",
              "optional": false
            },
            {
              "name": "yScale",
              "role": "y_scale",
              "type": "Number",
              "optional": false
            },
            {
              "name": "List of Data",
              "role": "data_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "List of Frequencies",
              "role": "frequency_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "Outliers",
              "role": "show_outliers",
              "type": "Boolean",
              "optional": false
            }
          ],
          "description": "Allows data from a frequency table to be easily plotted as a boxplot, with optional outlier display."
        }
      ]
    },
    {
      "name": "ContingencyTable",
      "url": "https://geogebra.github.io/docs/manual/en/commands/ContingencyTable/",
      "overloads": [
        {
          "syntax": "ContingencyTable( <List of Text>, <List of Text> )",
          "params": [
            {
              "name": "List of Text",
              "role": "row_values",
              "type": "List(Text)",
              "optional": false
            },
            {
              "name": "List of Text",
              "role": "column_values",
              "type": "List(Text)",
              "optional": false
            }
          ],
          "description": "Draws a contingency table created from the two given lists. Unique values from the first list are used as row values, and unique values from the second list as column values."
        },
        {
          "syntax": "ContingencyTable( <List of Text>, <List of Text>, <Options> )",
          "params": [
            {
              "name": "List of Text",
              "role": "row_values",
              "type": "List(Text)",
              "optional": false
            },
            {
              "name": "List of Text",
              "role": "column_values",
              "type": "List(Text)",
              "optional": false
            },
            {
              "name": "Options",
              "role": "display_options",
              "type": "Text",
              "optional": false
            }
          ],
          "description": "Draws a contingency table from the two lists. The text Options controls display of column percentages (\"|\"), row percentages (\"_\"), total percentages (\"+\"), expected counts (\"e\"), Chi-squared contributions (\"k\"), and Chi-squared test results (\"=\")."
        },
        {
          "syntax": "ContingencyTable( <List of Row Values>, <List of Column Values>, <Frequency Table> )",
          "params": [
            {
              "name": "List of Row Values",
              "role": "row_values",
              "type": "List(Text)",
              "optional": false
            },
            {
              "name": "List of Column Values",
              "role": "column_values",
              "type": "List(Text)",
              "optional": false
            },
            {
              "name": "Frequency Table",
              "role": "frequency_table",
              "type": "List(List(Number))",
              "optional": false
            }
          ],
          "description": "Draws a contingency table using the given list of row values, column values and corresponding frequency table."
        },
        {
          "syntax": "ContingencyTable( <List of Row Values>, <List of Column Values>, <Frequency Table>, <Options> )",
          "params": [
            {
              "name": "List of Row Values",
              "role": "row_values",
              "type": "List(Text)",
              "optional": false
            },
            {
              "name": "List of Column Values",
              "role": "column_values",
              "type": "List(Text)",
              "optional": false
            },
            {
              "name": "Frequency Table",
              "role": "frequency_table",
              "type": "List(List(Number))",
              "optional": false
            },
            {
              "name": "Options",
              "role": "display_options",
              "type": "Text",
              "optional": false
            }
          ],
          "description": "Draws a contingency table using the given row values, column values and frequency table. Options control additional statistics as above."
        }
      ]
    },
    {
      "name": "DotPlot",
      "url": "https://geogebra.github.io/docs/manual/en/commands/DotPlot/",
      "overloads": [
        {
          "syntax": "DotPlot( <List of Raw Data> )",
          "params": [
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Returns a dot plot for the given list of data and also the list of dot plot points. Repeated values produce stacked points (n,1)...(n,k). Works for numeric or text lists."
        },
        {
          "syntax": "DotPlot( <List of Raw Data>, <Stack Adjacent Dots (optional)>, <Scale Factor (optional)> )",
          "params": [
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Stack Adjacent Dots",
              "role": "stack_adjacent",
              "type": "Boolean",
              "optional": true
            },
            {
              "name": "Scale Factor",
              "role": "y_scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "Returns a dot plot for the given list with possible vertical scaling. If Scale Factor = s, points are (n, 1s)...(n, ks). If Stack Adjacent Dots is true, nearby points are visually stacked; if false, result is as in the basic form."
        }
      ]
    },
    {
      "name": "FrequencyPolygon",
      "url": "https://geogebra.github.io/docs/manual/en/commands/FrequencyPolygon/",
      "overloads": [
        {
          "syntax": "FrequencyPolygon( <List of Class Boundaries>, <List of Heights> )",
          "params": [
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Heights",
              "role": "height_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Creates a frequency polygon with vertices at the given heights. Class boundaries determine x-coordinates of vertices."
        },
        {
          "syntax": "FrequencyPolygon( <List of Class Boundaries>, <List of Raw Data>, <Boolean Use Density>, <Density Scale Factor (optional)> )",
          "params": [
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Use Density",
              "role": "use_density",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Density Scale Factor",
              "role": "density_scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "Creates a frequency polygon from raw data. Class boundaries define classes and x-coordinates. If Use Density = true, vertex height = DensityScaleFactor * class_frequency / class_width; otherwise height = class_frequency. Default: Use Density = true, Density Scale Factor = 1."
        },
        {
          "syntax": "FrequencyPolygon( <Boolean Cumulative>, <List of Class Boundaries>, <List of Raw Data>, <Boolean Use Density>, <Density Scale Factor (optional)> )",
          "params": [
            {
              "name": "Cumulative",
              "role": "cumulative",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Use Density",
              "role": "use_density",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Density Scale Factor",
              "role": "density_scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "If Cumulative is true, creates a frequency polygon where each vertex y-coordinate equals the frequency of the class plus the sum of all previous frequencies (possibly using density)."
        }
      ]
    },
    {
      "name": "FrequencyTable",
      "url": "https://geogebra.github.io/docs/manual/en/commands/FrequencyTable/",
      "overloads": [
        {
          "syntax": "FrequencyTable( <List of Raw Data> )",
          "params": [
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Returns a text table whose first column contains sorted unique values of the list and second column the count of each value. List elements may be numbers or text."
        },
        {
          "syntax": "FrequencyTable( <Boolean Cumulative>, <List of Raw Data> )",
          "params": [
            {
              "name": "Cumulative",
              "role": "cumulative",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "If Cumulative = false, returns the same table as Frequency( <List of Raw Data> ). If true, second column contains cumulative frequencies."
        },
        {
          "syntax": "FrequencyTable( <List of Class Boundaries>, <List of Raw Data> )",
          "params": [
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "Returns a text table whose first column contains class intervals and second column the number of data values in each interval. All but the last interval are [a,b), the last is [a,b]."
        },
        {
          "syntax": "FrequencyTable( <Boolean Cumulative>, <List of Class Boundaries>, <List of Raw Data> )",
          "params": [
            {
              "name": "Cumulative",
              "role": "cumulative",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            }
          ],
          "description": "If Cumulative = false, returns the same table as FrequencyTable( <List of Class Boundaries>, <List of Raw Data> ). If true, second column contains cumulative frequencies."
        },
        {
          "syntax": "FrequencyTable( <List of Class Boundaries>, <List of Raw Data>, <Use Density>, <Density Scale Factor (optional)> )",
          "params": [
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Use Density",
              "role": "use_density",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Density Scale Factor",
              "role": "density_scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "Returns a text table whose first column contains intervals and second column contains frequencies suitable for the corresponding Histogram command."
        },
        {
          "syntax": "FrequencyTable( <Boolean Cumulative>, <List of Class Boundaries>, <List of Raw Data>, <Use Density>, <Density Scale Factor (optional)> )",
          "params": [
            {
              "name": "Cumulative",
              "role": "cumulative",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "List of Class Boundaries",
              "role": "class_boundaries",
              "type": "List",
              "optional": false
            },
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Use Density",
              "role": "use_density",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Density Scale Factor",
              "role": "density_scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "Returns a text table whose first column contains intervals and second column contains (optionally cumulative) frequencies for the corresponding Histogram command."
        },
        {
          "syntax": "FrequencyTable( <List of Raw Data>, <Scale Factor (optional)> )",
          "params": [
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List",
              "optional": false
            },
            {
              "name": "Scale Factor",
              "role": "scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "Returns a text table whose first column Value contains sorted unique values of the raw data and second column Frequency contains counts multiplied by the Scale Factor."
        }
      ]
    },
    {
      "name": "Histogram",
      "url": "https://geogebra.github.io/docs/manual/en/commands/Histogram/",
