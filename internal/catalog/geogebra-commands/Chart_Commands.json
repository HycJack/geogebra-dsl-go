    {
      "name": "BarChart",
      "url": "https://geogebra.github.io/docs/manual/en/commands/BarChart/",
      "overloads": [
        {
          "syntax": "BarChart( <List of Data>, <List of Frequencies> )",
          "params": [
            {
              "name": "List of Data",
              "role": "data_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "List of Frequencies",
              "role": "frequency_list",
              "type": "List(Number)",
              "optional": false
            }
          ],
          "description": "Creates a bar chart using the list of data with corresponding frequencies."
        },
        {
          "syntax": "BarChart( <List of Raw Data>, <Width of Bars>, <Vertical Scale Factor (optional)> )",
          "params": [
            {
              "name": "List of Raw Data",
              "role": "raw_data_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "Width of Bars",
              "role": "bar_width",
              "type": "Number",
              "optional": false
            },
            {
              "name": "Vertical Scale Factor",
              "role": "vertical_scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "Creates a bar chart using the given raw data; the bars have the given width and the height of the bars depends on the vertical scale factor."
        },
        {
          "syntax": "BarChart( <List of Data>, <List of Frequencies>, <Width of Bars> )",
          "params": [
            {
              "name": "List of Data",
              "role": "data_list",
