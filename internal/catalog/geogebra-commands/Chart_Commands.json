            },
            {
              "name": "List of y-coordinates",
              "role": "y_list",
              "type": "List(Number)",
              "optional": false
            }
          ],
          "description": "Draws a stick graph for points created from coordinate lists. For each point, a vertical segment is drawn from the x-axis to the point."
        },
        {
          "syntax": "StickGraph( <List of x-coordinates>, <List of y-coordinates>, <Boolean Horizontal> )",
          "params": [
            {
              "name": "List of x-coordinates",
              "role": "x_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "List of y-coordinates",
              "role": "y_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "Horizontal",
              "role": "horizontal",
              "type": "Boolean",
              "optional": false
            }
          ],
          "description": "Draws a stick graph of points from coordinate lists. If Horizontal = true, segments extend horizontally from the y-axis; if false, vertically from the x-axis."
        }
      ]
    }
  ]
