              "type": "List",
              "optional": false
            }
          ],
          "description": "Creates a histogram with bars of the given heights. Class boundaries determine width and position of each bar."
        },
        {
          "syntax": "Histogram( <List of Class Boundaries>, <List of Raw Data>, <Boolean Use Density>, <Density Scale Factor (optional)> )",
          "params": [
            {
              "name": "List of Class Boundaries",
