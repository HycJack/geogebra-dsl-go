              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Density Scale Factor",
              "role": "density_scale_factor",
              "type": "Number",
              "optional": true
            }
          ],
          "description": "Same as Histogram( <List of Class Boundaries>, <List of Raw Data>, <Boolean Use Density>, <Density Scale Factor> ), except data equal to the right border of a class are counted in this class, not the next one."
        },
        {
          "syntax": "HistogramRight( <Boolean Cumulative>, <List of Class Boundaries>, <List of Raw Data>, <Boolean Use Density>, <Density Scale Factor (optional)> )",
          "params": [
            {
