              "optional": false
            },
            {
              "name": "Function",
              "role": "model_function",
              "type": "Function",
              "optional": false
            }
          ],
          "description": "Returns a list of points whose x-coordinates are those of the input points and y-coordinates are residuals relative to the given function. For input point (a,b), output is (a, b - f(a))."
        }
      ]
    },
    {
      "name": "StemPlot",
      "url": "https://geogebra.github.io/docs/manual/en/commands/StemPlot/",
      "overloads": [
        {
          "syntax": "StemPlot( <List> )",
          "params": [
            {
              "name": "List",
              "role": "raw_data_list",
              "type": "List(Number)",
              "optional": false
            }
          ],
          "description": "Returns a stem plot of the given numeric list. Outliers are removed from the main plot and listed separately. Outliers are values outside [Q1 - 1.5(Q3 - Q1), Q3 + 1.5(Q3 - Q1)]."
        },
        {
          "syntax": "StemPlot( <List>, <Adjustment -1|0|1> )",
          "params": [
            {
              "name": "List",
              "role": "raw_data_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "Adjustment",
              "role": "stem_unit_adjustment",
              "type": "Enum(-1|0|1)",
              "optional": false
            }
          ],
          "description": "Returns a stem plot of the given list. If Adjustment = -1, the default stem unit is divided by 10; if 0, unchanged; if 1, multiplied by 10."
        }
      ]
    },
    {
      "name": "StepGraph",
      "url": "https://geogebra.github.io/docs/manual/en/commands/StepGraph/",
      "overloads": [
        {
          "syntax": "StepGraph( <List of Points> )",
          "params": [
            {
              "name": "List of Points",
              "role": "point_list",
              "type": "List(Point)",
              "optional": false
            }
          ],
          "description": "Draws a step graph for the given list of points. Each point is connected to the next by a horizontal line segment."
        },
        {
          "syntax": "StepGraph( <List of Points>, <Boolean Join> )",
          "params": [
            {
              "name": "List of Points",
              "role": "point_list",
              "type": "List(Point)",
              "optional": false
            },
            {
              "name": "Join",
              "role": "join_vertical",
              "type": "Boolean",
              "optional": false
            }
          ],
          "description": "Draws a step graph of the given points. If Join = false, only horizontal segments reach the x-coordinate of the next point. If Join = true, each pair of points is connected by a horizontal and a vertical segment."
        },
        {
          "syntax": "StepGraph( <List of x-coordinates>, <List of y-coordinates> )",
          "params": [
            {
              "name": "List of x-coordinates",
              "role": "x_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "List of y-coordinates",
              "role": "y_list",
              "type": "List(Number)",
              "optional": false
            }
          ],
          "description": "Draws a step graph for points built from the coordinate lists. Each point is connected to the next by a horizontal line segment."
        },
        {
          "syntax": "StepGraph( <List of x-coordinates>, <List of y-coordinates>, <Boolean Join> )",
          "params": [
            {
              "name": "List of x-coordinates",
              "role": "x_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "List of y-coordinates",
              "role": "y_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "Join",
              "role": "join_vertical",
              "type": "Boolean",
              "optional": false
            }
          ],
          "description": "Draws a step graph of points from coordinate lists. If Join = false, only horizontal segments; if true, horizontal plus vertical segments between successive points."
        },
        {
          "syntax": "StepGraph( <List of x-coordinates>, <List of y-coordinates>, <Boolean Join>, <Point Style> )",
          "params": [
            {
              "name": "List of x-coordinates",
              "role": "x_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "List of y-coordinates",
              "role": "y_list",
              "type": "List(Number)",
              "optional": false
            },
            {
              "name": "Join",
              "role": "join_vertical",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Point Style",
              "role": "point_style",
              "type": "Integer",
              "optional": false
            }
          ],
          "description": "Draws a step graph as above and controls point drawing style. Point style meanings: 0=no points; 1=solid on right; 2=solid right, open left; -1=solid left; -2=solid left, open right."
        },
        {
          "syntax": "StepGraph( <List of Points>, <Boolean Join>, <Point Style> )",
          "params": [
            {
              "name": "List of Points",
              "role": "point_list",
              "type": "List(Point)",
              "optional": false
            },
            {
              "name": "Join",
              "role": "join_vertical",
              "type": "Boolean",
              "optional": false
            },
            {
              "name": "Point Style",
              "role": "point_style",
              "type": "Integer",
              "optional": false
            }
          ],
          "description": "Draws a step graph from a list of points with control over vertical joining and point style, as described above."
        }
      ]
    },
